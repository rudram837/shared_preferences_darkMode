<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Task">
        <activity
            android:name=".View.Activities.task2.SecondActivity"
            android:exported="false" />
        <activity
            android:name=".View.Activities.task2.FirstActivity"
            android:exported="false" />
        <activity
            android:name=".View.Activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="android.max_aspect"
            android:value="1.2" />

        <activity
            android:name=".View.Activities.task1.ListDataActivity"
            android:exported="false" />
        <activity
            android:name=".View.Activities.task1.DetailActivity"
            android:exported="false" />
        <activity
            android:name=".View.Activities.task1.MainActivity"
            android:exported="false" />
    </application>

</manifest>